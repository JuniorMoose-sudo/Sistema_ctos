# Copie para .env e preencha com os valores reais. Nunca commitar o .env de verdade.

# String de conexão do Neon (Dashboard do Neon > Connection Details > Connection string)
# Exemplo: postgresql://usuario:senha@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://usuario:senha@host.neon.tech/neondb?sslmode=require

# Gere com: python -c "import secrets; print(secrets.token_urlsafe(50))"
# Em produção (DEBUG=False) o Django recusa iniciar sem SECRET_KEY real.
SECRET_KEY=troque-por-uma-chave-secreta-gerada
DEBUG=True

# Hosts permitidos (separados por vírgula). Em produção: domínio + IP da máquina.
ALLOWED_HOSTS=localhost,127.0.0.1

# Origens confiáveis para o CSRF quando o site está num domínio (ex.: https://sistema.suaempresa.com.br).
# Em branco = aceita apenas localhost.
CSRF_TRUSTED_ORIGINS=

# True se o Django for servido atrás de HTTPS (ex.: Nginx + Let's Encrypt).
USE_HTTPS=False

# Usado pelo script de geocodificação para identificar as requisições ao Nominatim
# (obrigatório pela política de uso do Nominatim -- eles bloqueiam User-Agent genérico)
NOMINATIM_USER_AGENT=sistema-ctos-campina-grande/1.0 (seu-email@exemplo.com)

# Dashboard (streamlit run dashboard/app.py)
API_BASE_URL=http://localhost:8000/api
# Token de um usuário gestor (crie em /admin/ > Tokens, ou `python manage.py drf_create_token <user>`)
API_TOKEN=troque-por-um-token-de-gestor
