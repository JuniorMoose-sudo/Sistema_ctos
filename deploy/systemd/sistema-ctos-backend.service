[Unit]
Description=Sistema CTOs - Backend (Django/gunicorn)
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/opt/sistema_ctos/backend
EnvironmentFile=/opt/sistema_ctos/.env
ExecStart=/opt/sistema_ctos/.venv/bin/gunicorn config.wsgi:application \
    --bind 127.0.0.1:8000 \
    --workers 3 \
    --threads 4 \
    --access-logfile /opt/sistema_ctos/backend/logs/gunicorn-access.log \
    --error-logfile /opt/sistema_ctos/backend/logs/gunicorn-error.log
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
