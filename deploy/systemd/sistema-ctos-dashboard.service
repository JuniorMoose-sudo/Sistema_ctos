[Unit]
Description=Sistema CTOs - Dashboard (Streamlit)
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/opt/sistema_ctos/dashboard
EnvironmentFile=/opt/sistema_ctos/.env
ExecStart=/opt/sistema_ctos/.venv/bin/python -m streamlit run app.py \
    --server.address=127.0.0.1 \
    --server.port=8501 \
    --server.headless=true
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
