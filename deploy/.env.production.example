# Copie para /opt/sistema_ctos/.env (o deploy.sh cria a partir deste modelo).
# Nunca commitar o .env de verdade.

# --- Banco de dados (Neon) ---
# OBS: em Linux, use apenas sslmode=require (sem channel_binding=require, que é só do libpq do Windows).
DATABASE_URL=postgresql://usuario:senha@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# --- Django ---
SECRET_KEY=<SECRET_KEY>
DEBUG=False

# Subdomínios nip.io do IP público da instância (deploy.sh substitui <IP>).
ALLOWED_HOSTS=sistema.<IP>.nip.io,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://sistema.<IP>.nip.io

# Deixe False até rodar o certbot; depois o deploy.sh orienta ligar (https:// em produção).
USE_HTTPS=False

# Usado pelo script de geocodificação para identificar as requisições ao Nominatim.
NOMINATIM_USER_AGENT=sistema-ctos-campina-grande/1.0 (seu-email@exemplo.com)

# --- Dashboard (Streamlit roda no próprio servidor, então usa a API interna) ---
API_BASE_URL=http://127.0.0.1:8000/api
# Token de um usuário gestor (crie em /admin/ > Tokens, ou `python manage.py drf_create_token <user>`).
API_TOKEN=troque-por-um-token-de-gestor
